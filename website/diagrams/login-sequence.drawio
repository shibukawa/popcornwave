        <mxCell id="m0" value="GET /auth/login" style="endArrow=blockThin;endFill=1;html=1;dashed=0;strokeColor=#4C8BF5;strokeWidth=1.5;fontColor=#4C8BF5;fontSize=12;verticalAlign=bottom;labelBackgroundColor=none" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="120" as="sourcePoint" /><mxPoint x="455.0" y="120" as="targetPoint" /></mxGeometry></mxCell>

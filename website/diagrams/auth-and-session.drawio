<mxfile host="app.diagrams.net">
  <diagram name="auth-and-session" id="auth-and-session">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="when-auth" value="at sign-in, once" style="text;html=1;align=center;fontColor=#8A94A6;fontSize=13;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="when-session" value="on every request after it" style="text;html=1;align=center;fontColor=#8A94A6;fontSize=13;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="470" y="20" width="330" height="24" as="geometry" />
        </mxCell>

        <mxCell id="auth" value="auth&#xa;&#xa;Decides who this is" style="rounded=1;arcSize=12;html=1;fillColor=none;strokeColor=#8A94A6;strokeWidth=1.5;fontColor=#8A94A6;fontSize=14;fontStyle=1;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="session" value="session&#xa;&#xa;Carries who it decided,&#xa;and what is true of them now" style="rounded=1;arcSize=12;html=1;fillColor=none;strokeColor=#8A94A6;strokeWidth=1.5;fontColor=#8A94A6;fontSize=14;fontStyle=1;verticalAlign=middle" vertex="1" parent="1">
          <mxGeometry x="470" y="56" width="330" height="90" as="geometry" />
        </mxCell>

        <mxCell id="handover" value="an account ID" style="html=1;strokeColor=#8A94A6;strokeWidth=1.5;fontColor=#8A94A6;fontSize=13;endArrow=block;endFill=1" edge="1" parent="1" source="auth" target="session">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="idp" value="external IdP&#xa;devidp in development" style="rounded=1;arcSize=12;html=1;fillColor=none;strokeColor=#8A94A6;strokeWidth=1.5;fontColor=#8A94A6;fontSize=13;dashed=1" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="authstate" value="authstate&#xa;one round trip, consumed" style="rounded=1;arcSize=12;html=1;fillColor=none;strokeColor=#8A94A6;strokeWidth=1.5;fontColor=#8A94A6;fontSize=13;dashed=1" vertex="1" parent="1">
          <mxGeometry x="220" y="210" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sessionstore" value="sessionstore&#xa;rdb, cookie, or redis" style="rounded=1;arcSize=12;html=1;fillColor=none;strokeColor=#8A94A6;strokeWidth=1.5;fontColor=#8A94A6;fontSize=13;dashed=1" vertex="1" parent="1">
          <mxGeometry x="470" y="210" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="auth-idp" style="html=1;strokeColor=#8A94A6;strokeWidth=1.5;endArrow=none;dashed=1" edge="1" parent="1" source="auth" target="idp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auth-state" style="html=1;strokeColor=#8A94A6;strokeWidth=1.5;endArrow=none;dashed=1" edge="1" parent="1" source="auth" target="authstate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="session-store" style="html=1;strokeColor=#8A94A6;strokeWidth=1.5;endArrow=none;dashed=1" edge="1" parent="1" source="session" target="sessionstore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

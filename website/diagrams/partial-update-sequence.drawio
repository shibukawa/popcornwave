        <mxCell id="label_doc" value="A request with no update header. The runtime is not involved at all." style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#4C8BF5;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="104" width="620" height="24" as="geometry" /></mxCell>

        <mxCell id="d1" value="GET /orders?sort=newest" style="endArrow=blockThin;endFill=1;html=1;dashed=0;strokeColor=#4C8BF5;strokeWidth=1.5;fontColor=#4C8BF5;fontSize=12;verticalAlign=bottom;labelBackgroundColor=none" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="156" as="sourcePoint" /><mxPoint x="855.0" y="156" as="targetPoint" /></mxGeometry></mxCell>


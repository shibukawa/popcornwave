        <mxCell id="d4" value="the browser parses it and&lt;br&gt;paints a new page" style="rounded=1;arcSize=20;html=1;align=left;spacingLeft=10;fillColor=none;strokeColor=#4C8BF5;fontColor=#4C8BF5;fontSize=12" vertex="1" parent="1"><mxGeometry x="20" y="268" width="290" height="44" as="geometry" /></mxCell>

        <mxCell id="label_update" value="The same URL and the same handler. The headers are the only difference." style="text;html=1;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#3FA46A;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="356" width="660" height="24" as="geometry" /></mxCell>

        <mxCell id="u1" value="a link or a GET form, intercepted" style="endArrow=blockThin;endFill=1;html=1;dashed=0;strokeColor=#3FA46A;strokeWidth=1.5;fontColor=#3FA46A;fontSize=12;verticalAlign=bottom;labelBackgroundColor=none" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="404" as="sourcePoint" /><mxPoint x="475.0" y="404" as="targetPoint" /></mxGeometry></mxCell>


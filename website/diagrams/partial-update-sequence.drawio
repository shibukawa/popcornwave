        <mxCell id="runtime" value="Runtime in the page" style="rounded=0;html=1;fillColor=none;strokeColor=#8A94A6;strokeWidth=1.5;fontColor=#8A94A6;fontSize=13;fontStyle=1" vertex="1" parent="1"><mxGeometry x="380" y="40" width="190" height="44" as="geometry" /></mxCell>
        <mxCell id="runtime_life" style="endArrow=none;dashed=1;html=1;strokeColor=#8A94A6;strokeWidth=1" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475.0" y="84" as="sourcePoint" /><mxPoint x="475.0" y="676" as="targetPoint" /></mxGeometry></mxCell>


        <mxCell id="u4" value="200 ndjson — replace #results, and nothing else" style="endArrow=blockThin;endFill=1;html=1;dashed=0;strokeColor=#3FA46A;strokeWidth=1.5;fontColor=#3FA46A;fontSize=12;verticalAlign=bottom;labelBackgroundColor=none" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855.0" y="550" as="sourcePoint" /><mxPoint x="475.0" y="550" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="u5" value="swap #results into the live DOM" style="endArrow=blockThin;endFill=1;html=1;dashed=0;strokeColor=#3FA46A;strokeWidth=1.5;fontColor=#3FA46A;fontSize=12;verticalAlign=bottom;labelBackgroundColor=none" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475.0" y="600" as="sourcePoint" /><mxPoint x="135.0" y="600" as="targetPoint" /></mxGeometry></mxCell>

